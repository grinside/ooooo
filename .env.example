# Max IT TV Affiliation System - Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=production

# ============================================================================
# SERVER
# ============================================================================
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
API_URL=http://localhost/api
APP_URL=http://localhost

# Proxy settings (set to true if behind a reverse proxy)
TRUST_PROXY=true

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=maxittv
DB_USER=postgres
DB_PASSWORD=change_this_secure_password

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# SSL settings
DB_SSL=false

# Timeouts (in milliseconds)
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# ============================================================================
# REDIS (Cache & Sessions)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=maxittv:
REDIS_TTL=3600

# Queue Redis (can use same Redis with different DB)
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
JWT_SECRET=change_this_to_a_very_secure_random_string
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=maxittv-affiliation
JWT_AUDIENCE=maxittv-api

# ============================================================================
# SECURITY
# ============================================================================
SESSION_SECRET=change_this_session_secret
BCRYPT_ROUNDS=12

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ============================================================================
# PAYMENT PROVIDERS
# ============================================================================

# Orange Money
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1

# Wave
WAVE_API_KEY=
WAVE_SECRET_KEY=
WAVE_BASE_URL=https://api.wave.com/v1

# MTN Mobile Money
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_USER_ID=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# SMS PROVIDERS
# ============================================================================

# Orange SMS
ORANGE_SMS_API_KEY=
ORANGE_SMS_API_SECRET=
ORANGE_SMS_SENDER_ID=MaxITTV
ORANGE_SMS_BASE_URL=https://api.orange.com/smsmessaging/v1

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# COMMISSION SETTINGS
# ============================================================================
COMMISSION_DIRECT_RATE=0.10
COMMISSION_LEVEL2_RATE=0.05
COMMISSION_LEVEL3_RATE=0.03
MINIMUM_PAYOUT=10000
PAYOUT_DAY=1
COMMISSION_PROCESSING_FEE=0.02

# ============================================================================
# SUBSCRIPTION SETTINGS
# ============================================================================
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_REMINDER_DAYS=3
SUBSCRIPTION_GRACE_PERIOD_DAYS=2
SUBSCRIPTION_AUTO_RENEW=true

# ============================================================================
# AFFILIATE SETTINGS
# ============================================================================
AFFILIATE_CODE_LENGTH=8
AFFILIATE_MIN_WITHDRAWAL=10000
AFFILIATE_MAX_NETWORK_DEPTH=3
AFFILIATE_VERIFICATION_REQUIRED=true

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/maxittv

# Elasticsearch (optional - for centralized logging)
ELASTICSEARCH_NODE=
ELASTICSEARCH_INDEX=maxittv-logs

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Max IT TV API (if integrating with existing Max IT TV platform)
MAXITTV_API_URL=
MAXITTV_API_KEY=

# ============================================================================
# FILE UPLOAD
# ============================================================================
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_DESTINATION=./uploads

# ============================================================================
# CACHE
# ============================================================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# ============================================================================
# MONITORING
# ============================================================================
MONITORING_ENABLED=true
SENTRY_DSN=
HEALTH_CHECK_INTERVAL=60000

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_QR_CODES=true
FEATURE_MULTI_LEVEL_COMMISSION=true
FEATURE_AUTO_PAYOUTS=false
FEATURE_SMS_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=false

# ============================================================================
# DOCKER SERVICES
# ============================================================================

# HTTP/HTTPS Ports
HTTP_PORT=80
HTTPS_PORT=443

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_INSTALL_PLUGINS=

# Elasticsearch (optional)
ELASTICSEARCH_PORT=9200

# Worker Settings
WORKER_CONCURRENCY=5
