# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=maxittv_affiliation
DB_USER=maxittv
DB_PASSWORD=changeme_secure_password
DB_POOL_MIN=10
DB_POOL_MAX=50

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_DB=0

# JWT
JWT_SECRET=changeme_min_32_chars_secure_secret_key_here_production
JWT_REFRESH_SECRET=changeme_refresh_secret_key_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Commission Rates (%)
COMMISSION_DIRECT_RATE=15
COMMISSION_NETWORK_L1_RATE=5
COMMISSION_NETWORK_L2_RATE=2
COMMISSION_BONUS_THRESHOLD=10
COMMISSION_BONUS_AMOUNT=5000

# Payout Configuration
PAYOUT_MIN_AMOUNT=5000
PAYOUT_PROCESSING_FEE_RATE=1.5
PAYOUT_DAILY_LIMIT=5000000
PAYOUT_AUTO_PROCESS_THRESHOLD=50000

# Payment Providers
# Orange Money
ORANGE_MONEY_API_KEY=your_orange_money_api_key
ORANGE_MONEY_API_SECRET=your_orange_money_secret
ORANGE_MONEY_MERCHANT_ID=your_merchant_id
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1

# Wave
WAVE_API_KEY=your_wave_api_key
WAVE_SECRET_KEY=your_wave_secret
WAVE_BASE_URL=https://api.wave.com/v1

# MTN Mobile Money
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_API_SECRET=your_mtn_secret
MTN_MOMO_USER_ID=your_mtn_user_id
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Stripe (backup)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SMS Configuration
SMS_PROVIDER=orange
SMS_SENDER_NAME=MaxITTV

# Orange SMS API
ORANGE_SMS_CLIENT_ID=your_orange_sms_client_id
ORANGE_SMS_CLIENT_SECRET=your_orange_sms_secret
ORANGE_SMS_BASE_URL=https://api.orange.com/smsmessaging/v1

# Twilio (fallback)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking (fallback)
AFRICAS_TALKING_API_KEY=your_africas_talking_key
AFRICAS_TALKING_USERNAME=your_username

# Feature Flags
FEATURE_NETWORK_COMMISSIONS=true
FEATURE_FRAUD_DETECTION=true
FEATURE_AUTO_PAYOUTS=false
FEATURE_SMS_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PUBLIC_MAX=20

# Queue Configuration
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=changeme_redis_password

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/maxittv
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_INDEX=maxittv-logs

# Security
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
SESSION_SECRET=changeme_session_secret_key

# CORS
CORS_ORIGIN=http://localhost:5173,https://maxittv.com
CORS_CREDENTIALS=true

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# App URLs
APP_URL=https://maxittv.com
ADMIN_URL=https://admin.maxittv.com
API_URL=https://api.maxittv.com

# Webhook URLs (for testing)
WEBHOOK_TEST_URL=https://webhook.site/your-unique-id
